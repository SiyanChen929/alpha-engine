# MarketData.app is optional; Yahoo is the public demonstration fallback.
MARKETDATA_TOKEN=

# Required only for ALFRED vintage queries. The public demo uses market series
# whose revisions are limited and labels them as latest-vintage observations.
FRED_API_KEY=

# SEC asks automated clients to identify themselves. Use a real contact value.
SEC_USER_AGENT=AlphaFactorEngine/0.1 research-contact@example.com

# Licensed adapters are inert until their roots and credentials are supplied.
WRDS_USERNAME=
CRSP_ROOT=
COMPUSTAT_ROOT=
IBES_ROOT=
TAQ_ROOT=
OPRA_ROOT=
BORROW_ROOT=
EVENTS_ROOT=

